{
  "name": "gamified-stem-platform",
  "version": "1.0.0",
  "description": "Offline-first gamified learning platform for rural STEM education",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client && npm run build:sw",
    "build:client": "webpack --mode production",
    "build:sw": "webpack --mode production --config webpack.sw.config.js",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6",
    "redis": "^4.6.7",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "jest": "^29.6.2"
  },
  "keywords": ["education", "stem", "offline", "gamification", "rural"],
  "author": "STEM Learning Platform Team",
  "license": "MIT"
}